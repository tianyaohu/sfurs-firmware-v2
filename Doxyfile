# Doxygen for our code only (generated HAL/CMSIS/MCSDK is excluded).
# Run: doxygen Doxyfile   -> build/doxygen/html/index.html
PROJECT_NAME           = "SFURS firmware"
OUTPUT_DIRECTORY       = build/doxygen
INPUT                  = src/nucleo/CM7/Core/Src \
                         src/nucleo/CM7/Core/Inc \
                         src/shared \
                         src/esc/Inc \
                         src/esc/bootloader/boot_main.c \
                         src/esc/motor_config/Src/drive_app.c \
                         src/esc/motor_config/Inc/drive_app.h \
                         docs prd architecture system-info open-questions \
                         technical-development-plans design-chronological \
                         hardware-test-results references
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */stm32h7xx_* */syscalls.c */sysmem.c \
                         */system_stm32h7xx_* */startup_* \
                         */fwu_test_image.*
EXCLUDE_SYMBOLS        = MX_* SystemClock_Config Error_Handler hfdcan1
USE_MDFILE_AS_MAINPAGE = architecture/index.md
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
JAVADOC_AUTOBRIEF      = YES
SOURCE_BROWSER         = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = YES
CALL_GRAPH             = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
# Every public symbol in INPUT must be documented; CI fails otherwise.
WARN_AS_ERROR          = YES
